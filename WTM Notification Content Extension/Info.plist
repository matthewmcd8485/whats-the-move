<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>WTM Notification Content Extension</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- Deliberately NOT "CustomPush".

			     A notification content extension *replaces* iOS's own rendering
			     of an image attachment in the long look, and all this one ever
			     drew was a plain image pinned to the edges — which is exactly
			     what the system does for free. So it contributed nothing but a
			     failure mode: whenever it couldn't load the image, you got a
			     large blank panel where the artwork should have been, instead
			     of the artwork iOS would have drawn itself.

			     Claiming a category that nothing ever sends leaves this target
			     inert and hands the long look back to the system. The target
			     can be deleted from the project outright — this key is only
			     the lever that's reachable without Xcode. -->
			<key>UNNotificationExtensionCategory</key>
			<array>
				<string>wtm.unusedContentExtension</string>
			</array>
			<key>UNNotificationExtensionDefaultContentHidden</key>
			<false/>
			<key>UNNotificationExtensionInitialContentSizeRatio</key>
			<real>0.75</real>
		</dict>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).NotificationViewController</string>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.usernotifications.content-extension</string>
	</dict>
</dict>
</plist>
